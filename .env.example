# PostgreSQL (used by Docker Compose and the backend in later phases)
POSTGRES_DB=devops_reviewer
POSTGRES_USER=devops_reviewer
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432

# Backend (Phase 2 activates these settings)
DATABASE_URL=postgresql+asyncpg://devops_reviewer:change-me-for-local-development@postgres:5432/devops_reviewer
SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
AI_MAX_INPUT_CHARACTERS=20000
AI_MAX_OUTPUT_TOKENS=2000
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
